<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

  <!-- Where to write files (override with env LOG_PATH or -DLOG_PATH=C:/logs) -->
  <property name="LOG_PATH" value="${LOG_PATH:-logs}" />
  <property name="APP_NAME" value="is-identity" />

  <!-- Patterns -->
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
  <!-- With colors (console only); enable colors via spring.output.ansi.enabled=ALWAYS -->
  <property name="LOG_PATTERN_COLOR"
            value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n"/>

  <!-- Console -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${LOG_PATTERN_COLOR}</pattern>
    </encoder>
  </appender>

  <!-- Rolling file: max 10MB per file, keep 30 days, cap total to 3GB -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/${APP_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>3GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- Your package at DEBUG -->
  <logger name="it.isgroup.identity" level="DEBUG" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <!-- Everything else at INFO -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>